# Paramètres de l'unique déploiement Docker.
MONGO_DB=ragdb
COMPOSE_PROJECT_NAME=ai-for-ssh-v3
NEXT_PUBLIC_API_BASE=/backend
WEB_BIND_ADDRESS=0.0.0.0
WEB_PORT=3001
EMBED_MODEL=bge-m3:latest
GEN_MODEL=llama3.2:3b
REWRITER_MODEL=llama3.2:3b
AGENT_MODEL=llama3.2:3b
PLANNER_MODEL=llama3.2:3b
EXTRACTION_MODEL=llama3.2:3b
SYNTHESIS_MODEL=llama3.2:3b
JUDGE_MODEL=llama3.2:3b
ENHANCEMENT_MODEL=llama3.2:3b
USE_CROSS_ENCODER=true
CROSS_ENCODER_LOCAL_PATH=/app/models/bge-reranker-v2-m3
CE_DEVICE=cpu
