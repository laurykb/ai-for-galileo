# -----------------------------
# RAG project portable defaults
# Copy to .env and customize.
# -----------------------------

# MongoDB
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=ragdb
# MONGO_USER=
# MONGO_PASSWORD=
# MONGO_URI=mongodb://localhost:27017

# Ollama
OLLAMA_HOST=http://localhost:11434
EMBED_MODEL=bge-m3:567m
REWRITER_MODEL=llama3.1:latest
GEN_MODEL=mistral-small3.2:latest
LLM_NUM_CTX=16384

# ── LANCEUR (serve.py : démarre Mongo + Ollama + l'app d'un coup) ──────────
# Renseigner si les binaires ne sont pas dans le PATH (ex. MongoDB portable).
# MONGO_BIN=/chemin/vers/mongod
# MONGO_DBPATH=/chemin/vers/data        # défaut : ./data/mongodb
# OLLAMA_BIN=/chemin/vers/ollama        # défaut : `ollama` du PATH

# ── MODE RAPIDE (latence) ────────────────────────────────────────────────
# Sur petit GPU, la génération (modèle 8B + contexte) déborde la VRAM → lent.
# Recette « rapide » (~5-6× plus vite, mesuré 27 s vs 150 s) : un petit modèle
# GPU-résident + un prompt épuré. COMPROMIS : un 3B est moins fiable que le 8B
# sur l'extraction critique → réserver à l'exploratoire, garder le 8B pour
# l'autoritatif. Pour activer :  (et: ollama pull llama3.2:3b)
#   RAG_FAST_MODE=true
#   GEN_MODEL=llama3.2:3b
#   AGENT_MODEL=llama3.2:3b
RAG_FAST_MODE=false
# GEN_NUM_CHUNKS : nb de chunks envoyés à la génération (défaut = NUM_CHUNKS).
# NB mesuré : le réduire ne gagne RIEN en vitesse et risque d'éjecter la bonne
# info — ne le baisser que si vous savez ce que vous faites.
# GEN_NUM_CHUNKS=15

# Affinage du contexte avant génération (précision → fidélité ; sans appel LLM).
# CONTEXT_DEDUP : retire les passages quasi-redondants (parent-child + RAPTOR se
#   recouvrent) ; CONTEXT_REORDER : place les meilleurs passages aux extrémités du
#   contexte (« lost in the middle »). Désactiver pour un A/B (faithfulness/precision).
CONTEXT_DEDUP=true
CONTEXT_DEDUP_THRESHOLD=0.85
CONTEXT_REORDER=true

# Cross-encoder
USE_CROSS_ENCODER=true
# CE_DEVICE=cpu
# CE_DEVICE=cuda:0
# CE_DEVICE=cuda:1
CE_RELEVANCE_THRESHOLD=0.505

# Retrieval
NUM_CHUNKS=15
RRF_K=60
WEIGHT_SEMANTIC=0.3
WEIGHT_BM25=0.7
MAX_CHUNK_LENGTH=25000
MAX_QUERY_CHARS=512

# Chunking / enhancement
CHUNKING_MODE=technical
AUTO_KEYWORDS=5
AUTO_QUESTIONS=3
# Modèle du rôle « enhance » (routé via core/model_router). Vide = REWRITER_MODEL.
# L'ENRICHISSEMENT est le maillon le plus LENT de l'ingestion (~85 % du temps :
# 1 appel LLM/chunk pour mots-clés+questions, +1/section pour RAPTOR). Recette
# « ingestion rapide » (aussi réglable par document dans l'UI Documents) :
#   ENHANCEMENT_MODEL=llama3.2:3b   (léger, ~2 Go ; pull : ollama pull llama3.2:3b)
#   OLLAMA_NUM_PARALLEL=2..3        (variable SERVEUR Ollama : un 3B tient à plusieurs
#                                    sur 8 Go → vrai parallélisme du pool de threads)
#   ENHANCE_MAX_WORKERS aligné sur OLLAMA_NUM_PARALLEL
# Désactiver RAPTOR_SUMMARIES accélère aussi nettement.
# ENHANCEMENT_MODEL=
# Parallélisme de l'enrichissement LLM (à aligner sur OLLAMA_NUM_PARALLEL)
ENHANCE_MAX_WORKERS=3
RAPTOR_SUMMARIES=true
RAPTOR_MIN_CHUNKS=3
RAPTOR_MAX_INPUT_CHUNKS=15

# Self-RAG
SELF_RAG_ENABLED=false
SELF_RAG_THRESHOLD=0.55
SELF_RAG_MAX_RETRIES=1

# Parent-child retrieval
PARENT_CHILD_ENABLED=false
PARENT_CHILD_MAX_CHARS=4000
NUM_CHUNKS_PARENT_CHILD=8

# Chroma
COLLECTION_NAME=test_rag

# Logging (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=INFO
